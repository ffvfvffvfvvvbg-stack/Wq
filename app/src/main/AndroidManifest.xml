<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permision.INTERNET" />
    <uses-permission android:name="android.permision.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permision.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permision.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permision.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permision.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permision.BIND_ACCESSILILITY_SERVICE" />
    <uses-permission android:name="android.permision.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permision.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permision.DELETE_PACKAGES" />

    <application
        android:name=". Telegram2App"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=". ScreenPermissionActivity"
            android:theme="@android:style/Theme.ranslucent.NoTitleBar"
            android:exported="false" />

        <service
            android:name=".remote.MyAccessibilityService"
            android:permision="android.permision.BIND_ACCESSILILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".remote.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

    </application>
</manifest>
